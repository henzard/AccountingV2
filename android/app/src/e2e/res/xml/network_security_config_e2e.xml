<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped cleartext allowance for the e2e build type ONLY (see the `e2e`
  buildType in android/app/build.gradle and this source set's
  AndroidManifest.xml overlay). The Detox journeys under e2e/journeys/ talk
  to a local Supabase stack over plain http via 10.0.2.2 (the emulator's
  alias for the CI runner's host loopback) — see cd.yml's e2e-gate job.

  Unlike the debug build (android/app/src/debug/AndroidManifest.xml), which
  sets a blanket android:usesCleartextTraffic="true" for local dev against
  any host, this only allows cleartext to the emulator-loopback and
  localhost addresses the e2e journeys actually use, and only for the e2e
  build type — it can never reach a production release APK.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
